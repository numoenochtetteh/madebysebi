# Optional override. The site defaults to https://madebysebi.com.
# NEXT_PUBLIC_SITE_URL=https://madebysebi.com

# Contact-form delivery via Resend.
# Add these to Vercel's Production environment. Keep the API key private.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@madebysebi.com

# madebysebi.com has been verified as a sending domain in Resend.
CONTACT_FROM_EMAIL=MadeBySebi Website <hello@madebysebi.com>

# The separate redesign review project uses the live site's existing mail
# endpoint when it has no Resend key. Set this only for that review project.
# CONTACT_RELAY_ENABLED=true
