# Optional until you buy your custom domain. On Vercel, the production URL is
# detected automatically. Later set this to https://madebysebi.com (or your final domain).
NEXT_PUBLIC_SITE_URL=

# Contact-form delivery via Resend.
# Create a free Resend account with hello.madebysebi@gmail.com and add the API key in Vercel.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello.madebysebi@gmail.com

# Keep this onboarding sender until you verify a custom domain in Resend.
CONTACT_FROM_EMAIL=MadeBySebi Website <onboarding@resend.dev>
